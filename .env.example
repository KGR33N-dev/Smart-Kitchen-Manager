# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="Smart-Fridge & Pantry Assistant"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# In development the app uses SQLite automatically (./kitchen.db) and the
# POSTGRES_* values are ignored. They are only used in staging/production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=kitchen_secret
POSTGRES_DB=smart_kitchen
# Optional explicit async URL override (used e.g. by tests):
# DATABASE_URL_OVERRIDE=sqlite+aiosqlite:///./kitchen.db

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# ── Background processing (Celery) ───────────────────────────────────────────
# USE_CELERY=false → receipt/camera scans are processed inline (no Redis needed).
# Set to true only when running a Redis broker + a Celery worker.
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# ── AI (vision) ──────────────────────────────────────────────────────────────
# AI_DEMO_MODE=true → scanning works with zero external model (heuristic parser).
# Set to false and configure the OpenAI-compatible endpoint below to use a real
# model (OpenAI GPT-4o or a local Ollama vision model).
AI_DEMO_MODE=true
# OpenAI cloud:
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o
# Local Ollama (default):
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2-vision

# ── Payments (Stripe, optional) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PREMIUM=price_...
FREE_TIER_SCAN_LIMIT=10

# ── Flower (Celery dashboard) ────────────────────────────────────────────────
FLOWER_USER=admin
FLOWER_PASSWORD=admin
